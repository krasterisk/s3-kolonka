[Unit]
Description=s3-kolonka voice gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kolonka
Group=kolonka
WorkingDirectory=/opt/s3-kolonka-gw
Environment=PYTHONUNBUFFERED=1
Environment=KOLONKA_GW_CONFIG=/opt/s3-kolonka-gw/config.yaml
ExecStart=/opt/s3-kolonka-gw/.venv/bin/python -m s3_kolonka_gw
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
