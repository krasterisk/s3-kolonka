[Unit]
Description=s3-kolonka voice gateway
After=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/s3-kolonka-gw
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/s3-kolonka-gw/.venv/bin/python -m s3_kolonka_gw
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
